@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName:       'Item',
    typeNamePlural: 'Items',
    title: { type: #STANDARD, value: 'ProductID' }
  }
}
annotate entity ZC_PRM_PITEM_MK with
{
  @UI.facet: [
    { id: 'idItem', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
      label: 'Item', position: 10 } ]

  @UI.hidden: true
  ItemUUID;
  @UI.hidden: true
  ParentUUID;

  // YENI: #TEXT_FIRST = once urun adi, parantez icinde kod:
  // "Facial Cleanser 200 ml (P0006)"
  @UI: { lineItem:       [ { position: 10 } ],
         identification: [ { position: 10 } ],
         textArrangement: #TEXT_FIRST }
  @EndUserText.label: 'Product'
  ProductID;

  // YENI: Urun adi ayri sutun olarak gorunmesin (zaten urun alaninda var)
  @UI.hidden: true
  ProductName;

  @UI: { lineItem:       [ { position: 20 } ],
         identification: [ { position: 20 } ] }
  @EndUserText.label: 'Regular Price'
  RegularPrice;

  @UI: { lineItem:       [ { position: 30 } ],
         identification: [ { position: 30 } ] }
  @EndUserText.label: 'Promo Price'
  PromoPrice;

  @UI: { lineItem:       [ { position: 40 } ],
         identification: [ { position: 40 } ] }
  @EndUserText.label: 'Discount %'
  DiscountPct;

  @UI.identification: [ { position: 50 } ]
  @EndUserText.label: 'Currency'
  CurrencyCode;

  @UI.hidden: true
  LocalLastChangedAt;
}