// ============================================================================
// PROJEKSIYON DAVRANIS TANIMI
// Cekirdekteki (ZR_) islemlerden hangilerinin bu uygulamada kullanilacagini
// secer. Burada yeni kural yazilmaz; sadece "use" ile mevcutlar disari acilir.
// ============================================================================
projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_PRM_PROMO_MK alias Promotion
use etag
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  // Onayla ve Yayinla aksiyonlarini Fiori uygulamasina ac.
  use action approve;
  use action publish;

  use association _Item { create; with draft; }
}

define behavior for ZC_PRM_PITEM_MK alias Item
use etag
{
  use update;
  use delete;
  use association _Promo { with draft; }
}