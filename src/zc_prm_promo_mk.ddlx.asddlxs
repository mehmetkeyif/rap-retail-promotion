// ============================================================================
// METADATA EXTENSION - Kampanya ekran tasarimi
// Fiori Elements bu anotasyonlari okuyup ekrani kendisi cizer.
// ============================================================================
@Metadata.layer: #CORE

// Detay sayfasinin basligi
@UI: {
  headerInfo: {
    typeName:       'Promotion',
    typeNamePlural: 'Promotions',
    title:       { type: #STANDARD, value: 'PromoID' },
    description: { type: #STANDARD, value: 'Description' }
  }
}
annotate entity ZC_PRM_PROMO_MK with
{
  // --------------------------------------------------------------------------
  // Detay sayfasindaki bolumler:
  // 1) General : identification ile isaretli alanlarin formu
  // 2) Items   : kalemler tablosu
  // --------------------------------------------------------------------------
  @UI.facet: [
    { id:       'idGeneral',
      purpose:  #STANDARD,
      type:     #IDENTIFICATION_REFERENCE,
      label:    'General',
      position: 10 },
    { id:            'idItems',
      purpose:       #STANDARD,
      type:          #LINEITEM_REFERENCE,
      label:         'Items',
      position:      20,
      targetElement: '_Item' } ]

  @UI.hidden: true
  PromoUUID;

  // --------------------------------------------------------------------------
  // YENI: Aksiyon butonlari
  // Butonlar herhangi bir alanin anotasyonuna eklenebilir; biz PromoID'ye
  // ekledik. Her listede (lineItem / identification) iki tur satir var:
  //  { position: 10 }  : Normal alan (sutun veya form alani)
  //  { type: #FOR_ACTION, dataAction: 'approve', label: 'Approve' }
  //                    : Buton. dataAction, davranis tanimindaki aksiyon
  //                      adiyla birebir ayni olmali.
  // lineItem icindeki butonlar   -> liste tablosunun ustunde gorunur
  // identification icindekiler   -> detay sayfasinin sag ustunde gorunur
  // Butonun aktif/pasif olmasina get_instance_features metodu karar verir.
  // --------------------------------------------------------------------------
  @UI: { lineItem:       [ { position: 10 },
                           { type: #FOR_ACTION, dataAction: 'approve', label: 'Approve' },
                           { type: #FOR_ACTION, dataAction: 'publish', label: 'Publish' } ],
         identification: [ { position: 10 },
                           { type: #FOR_ACTION, dataAction: 'approve', label: 'Approve' },
                           { type: #FOR_ACTION, dataAction: 'publish', label: 'Publish' } ],
         selectionField: [ { position: 10 } ] }
  @EndUserText.label: 'Promotion ID'
  PromoID;

  @UI: { lineItem:       [ { position: 20 } ],
         identification: [ { position: 20 } ] }
  @EndUserText.label: 'Description'
  Description;

  @UI: { lineItem:       [ { position: 30 } ],
         identification: [ { position: 30 } ],
         selectionField: [ { position: 20 } ] }
  @EndUserText.label: 'Type (P/F/B)'
  PromoType;

  @UI: { lineItem:       [ { position: 40 } ],
         identification: [ { position: 40 } ] }
  @EndUserText.label: 'Valid From'
  ValidFrom;

  @UI: { lineItem:       [ { position: 50 } ],
         identification: [ { position: 50 } ] }
  @EndUserText.label: 'Valid To'
  ValidTo;

  @UI: { lineItem:       [ { position: 60 } ],
         identification: [ { position: 60 } ],
         selectionField: [ { position: 30 } ] }
  @EndUserText.label: 'Status (N/A/X/E)'
  Status;

  @UI.identification: [ { position: 70 } ]
  @EndUserText.label: 'Currency'
  CurrencyCode;

  // Yonetim alanlari gizli
  @UI.hidden: true
  LocalCreatedBy;
  @UI.hidden: true
  LocalCreatedAt;
  @UI.hidden: true
  LocalLastChangedBy;
  @UI.hidden: true
  LocalLastChangedAt;
  @UI.hidden: true
  LastChangedAt;
}