@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName:       'Promotion',
    typeNamePlural: 'Promotions',
    title:       { type: #STANDARD, value: 'PromoID' },
    description: { type: #STANDARD, value: 'Description' }
  }
}
annotate entity ZC_PRM_PROMO_MK with
{
  @UI.facet: [
    { id: 'idGeneral', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
      label: 'General', position: 10 },
    { id: 'idItems', purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      label: 'Items', position: 20, targetElement: '_Item' } ]

  @UI.hidden: true
  PromoUUID;

  @UI: { lineItem:       [ { position: 10 },
                           { type: #FOR_ACTION, dataAction: 'approve', label: 'Approve' },
                           { type: #FOR_ACTION, dataAction: 'publish', label: 'Publish' } ],
         identification: [ { position: 10 },
                           { type: #FOR_ACTION, dataAction: 'approve', label: 'Approve' },
                           { type: #FOR_ACTION, dataAction: 'publish', label: 'Publish' } ],
         selectionField: [ { position: 10 } ] }
  @EndUserText.label: 'Promotion ID'
  PromoID;

  @UI: { lineItem:       [ { position: 20 } ],
         identification: [ { position: 20 } ] }
  @EndUserText.label: 'Description'
  Description;

  // YENI: textArrangement #TEXT_ONLY = kodu (P) degil, sadece metni
  // (Percent discount) goster. Duzenleme modunda acilir liste gelir.
  @UI: { lineItem:       [ { position: 30 } ],
         identification: [ { position: 30 } ],
         selectionField: [ { position: 20 } ],
         textArrangement: #TEXT_ONLY }
  @EndUserText.label: 'Type'
  PromoType;

  @UI: { lineItem:       [ { position: 40 } ],
         identification: [ { position: 40 } ] }
  @EndUserText.label: 'Valid From'
  ValidFrom;

  @UI: { lineItem:       [ { position: 50 } ],
         identification: [ { position: 50 } ] }
  @EndUserText.label: 'Valid To'
  ValidTo;

  // YENI: criticality = rengi StatusCriticality alanindan al
  // (Yayinda = yesil, Onayli = sari, Yeni = mavi, Bitti = gri)
  @UI: { lineItem:       [ { position: 60, criticality: 'StatusCriticality' } ],
         identification: [ { position: 60, criticality: 'StatusCriticality' } ],
         selectionField: [ { position: 30 } ],
         textArrangement: #TEXT_ONLY }
  @EndUserText.label: 'Status'
  Status;

  @UI.identification: [ { position: 70 } ]
  @EndUserText.label: 'Currency'
  CurrencyCode;

  // YENI: Yardimci alanlar; ayri sutun olarak gorunmesinler
  @UI.hidden: true
  PromoTypeText;
  @UI.hidden: true
  StatusText;
  @UI.hidden: true
  StatusCriticality;

  @UI.hidden: true
  LocalCreatedBy;
  @UI.hidden: true
  LocalCreatedAt;
  @UI.hidden: true
  LocalLastChangedBy;
  @UI.hidden: true
  LocalLastChangedAt;
  @UI.hidden: true
  LastChangedAt;
}