// ============================================================================
// DAVRANIS TANIMI - Kampanya is nesnesi
// Taslak destekli + belirlemeler + dogrulamalar
// ============================================================================
managed implementation in class zbp_r_prm_promo_mk unique;
strict ( 2 );
with draft;

define behavior for ZR_PRM_PROMO_MK alias Promotion
persistent table zprm_promo_mk
draft table zprm_promo_d_mk
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  create;
  update;
  delete;
  association _Item { create; with draft; }

  field ( numbering : managed, readonly ) PromoUUID;

  // YENI: PromoID ve Status artik kullanici tarafindan girilmez.
  // PromoID kaydederken otomatik verilir; Status ilerideki
  // Onayla/Aktive Et butonlariyla degisecek.
  field ( readonly ) PromoID, Status,
                     LocalCreatedBy, LocalCreatedAt,
                     LocalLastChangedBy, LocalLastChangedAt, LastChangedAt;

  // YENI: Zorunlu alanlar. Fiori bu alanlari kirmizi yildizla gosterir.
  field ( mandatory ) Description, PromoType, ValidFrom, ValidTo;

  // YENI: BELIRLEMELER (veriyi degistiren kurallar)
  // on modify { create; } : Kayit olusturuldugu anda calisir.
  determination setDefaults on modify { create; }
  // on save { create; } : Yeni kayit kaydedilirken (taslaktan asil kayda
  // aktarilirken) calisir. Numara ancak kaydedilince verilir, boylece
  // vazgecilen taslaklar numara harcamaz.
  determination setPromoID on save { create; }

  // YENI: DOGRULAMALAR (kontrol eden kurallar)
  // Kayit olusturulurken veya bu iki alandan biri degistiginde,
  // kaydetme aninda calisir.
  validation validateDates on save { create; field ValidFrom, ValidTo; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;

  // YENI: Prepare, kaydetmeden hemen once calisan kontrol noktasi.
  // Taslak senaryosunda dogrulamalar burada listelenmezse calismaz.
  // "Item~validateItem" = Item varligindaki validateItem dogrulamasi.
  draft determine action Prepare
  {
    validation validateDates;
    validation Item~validateItem;
  }

  mapping for zprm_promo_mk
  {
    PromoUUID          = promo_uuid;
    PromoID            = promo_id;
    Description        = description;
    PromoType          = promo_type;
    ValidFrom          = valid_from;
    ValidTo            = valid_to;
    Status             = status;
    CurrencyCode       = currency_code;
    LocalCreatedBy     = local_created_by;
    LocalCreatedAt     = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}

define behavior for ZR_PRM_PITEM_MK alias Item
persistent table zprm_pitem_mk
draft table zprm_pitem_d_mk
etag master LocalLastChangedAt
lock dependent by _Promo
authorization dependent by _Promo
{
  update;
  delete;
  association _Promo { with draft; }

  field ( numbering : managed, readonly ) ItemUUID;

  // YENI: Normal fiyat ve para birimi urunden gelir, kampanya fiyati
  // hesaplanir. Kullanici bunlari elle degistiremez.
  field ( readonly ) ParentUUID, LocalLastChangedAt,
                     RegularPrice, PromoPrice, CurrencyCode;

  // YENI: Kullanicinin girmesi gereken iki alan
  field ( mandatory ) ProductID, DiscountPct;

  // YENI: BELIRLEMELER
  // Urun secilince/degisince normal fiyati ve para birimini getir.
  determination fillFromProduct on modify { create; field ProductID; }
  // Indirim veya normal fiyat degisince kampanya fiyatini hesapla.
  // fillFromProduct normal fiyati degistirdiginde bu da otomatik tetiklenir.
  determination calculatePromoPrice on modify { field RegularPrice, DiscountPct; }

  // YENI: DOGRULAMA
  validation validateItem on save { create; field ProductID, DiscountPct; }

  // YENI: YAN ETKILER (side effects)
  // Fiori'ye "bu alan degisince su alanlari sunucudan yeniden oku" der.
  // Bu olmazsa hesaplanan fiyatlar ekranda ancak sayfa yenilenince gorunur.
  side effects
  {
    field ProductID affects field RegularPrice, field CurrencyCode, field PromoPrice;
    field DiscountPct affects field PromoPrice;
  }

  mapping for zprm_pitem_mk
  {
    ItemUUID           = item_uuid;
    ParentUUID         = parent_uuid;
    ProductID          = product_id;
    RegularPrice       = regular_price;
    PromoPrice         = promo_price;
    DiscountPct        = discount_pct;
    CurrencyCode       = currency_code;
    LocalLastChangedAt = local_last_changed_at;
  }
}