// ============================================================================
// DAVRANIS TANIMI - Kampanya is nesnesi (TASLAK DESTEKLI)
//
// with draft : Kullanici Edit'e bastiginda asil kayit degil, onun bir kopyasi
//              (taslak) duzenlenir. Save denince taslak asil kayda aktarilir.
//              Yarida birakilirsa taslak saklanir, sonra devam edilebilir.
// ============================================================================
managed implementation in class zbp_r_prm_promo_mk unique;
strict ( 2 );
with draft;

// ----------------------------------------------------------------------------
// KOK VARLIK: Kampanya basligi
// Asagidaki baslik satirlarinin anlami:
//  persistent table : Asil verinin yazildigi tablo
//  draft table      : Taslak kopyalarin tutuldugu tablo (Eclipse'e
//                     olusturtacagiz)
//  etag master      : Bu kaydin son degisiklik zamani. Iki kisinin ayni
//                     kaydi ayni anda ezmesini engeller.
//  lock master      : Kilitleme bu seviyede yapilir
//  total etag       : Tum is nesnesinin (baslik + kalemler) son degisiklik
//                     zamani. Taslaktan asil kayda aktarirken "bu arada
//                     baskasi degistirdi mi?" kontrolu icin. Taslakta zorunlu.
//  authorization master ( global ) : Genel yetki kontrolu bu seviyede
// ----------------------------------------------------------------------------
define behavior for ZR_PRM_PROMO_MK alias Promotion
persistent table zprm_promo_mk
draft table zprm_promo_d_mk
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  // Standart islemler
  create;
  update;
  delete;

  // Kalem ekleme. "with draft" = kampanya taslaktayken eklenen kalem de
  // taslak olarak eklenir.
  association _Item { create; with draft; }

  // UUID otomatik uretilir; yonetim alanlari RAP tarafindan doldurulur.
  field ( numbering : managed, readonly ) PromoUUID;
  field ( readonly ) LocalCreatedBy, LocalCreatedAt,
                     LocalLastChangedBy, LocalLastChangedAt, LastChangedAt;

  // Taslak yasam dongusu islemleri:
  //  Edit     : Mevcut kayittan taslak olustur (Edit butonu)
  //  Activate : Taslagi asil kayda aktar (Save butonu)
  //             "optimized" = daha az veritabani erisimiyle calisan surum
  //  Discard  : Taslagi at, degisikliklerden vazgec
  //  Resume   : Yarim kalmis taslaga geri don
  //  Prepare  : Kaydetmeden hemen once calisan kontrol noktasi. Ileride
  //             yazacagimiz dogrulamalar burada tetiklenecek.
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  // CDS alani = tablo alani eslestirmesi
  mapping for zprm_promo_mk
  {
    PromoUUID          = promo_uuid;
    PromoID            = promo_id;
    Description        = description;
    PromoType          = promo_type;
    ValidFrom          = valid_from;
    ValidTo            = valid_to;
    Status             = status;
    CurrencyCode       = currency_code;
    LocalCreatedBy     = local_created_by;
    LocalCreatedAt     = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}

// ----------------------------------------------------------------------------
// ALT VARLIK: Kampanya kalemi
//  draft table               : Kalemlerin taslak tablosu
//  lock dependent by _Promo  : Kalem degisince bagli kampanya kilitlenir
//  authorization dependent   : Yetki kampanyadan devralinir
// ----------------------------------------------------------------------------
define behavior for ZR_PRM_PITEM_MK alias Item
persistent table zprm_pitem_mk
draft table zprm_pitem_d_mk
etag master LocalLastChangedAt
lock dependent by _Promo
authorization dependent by _Promo
{
  update;
  delete;

  // Kalemden kampanyaya gecis, taslak farkinda
  association _Promo { with draft; }

  field ( numbering : managed, readonly ) ItemUUID;
  field ( readonly ) ParentUUID, LocalLastChangedAt;

  mapping for zprm_pitem_mk
  {
    ItemUUID           = item_uuid;
    ParentUUID         = parent_uuid;
    ProductID          = product_id;
    RegularPrice       = regular_price;
    PromoPrice         = promo_price;
    DiscountPct        = discount_pct;
    CurrencyCode       = currency_code;
    LocalLastChangedAt = local_last_changed_at;
  }
}