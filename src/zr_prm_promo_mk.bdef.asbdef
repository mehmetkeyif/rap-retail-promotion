// ============================================================================
// DAVRANIS TANIMI (Behavior Definition) - Kampanya is nesnesi
// CDS gorunumleri "veri neye benziyor" sorusunu cevaplar.
// Bu dosya ise "bu veriyle ne yapilabilir" sorusunu cevaplar:
// olusturma, degistirme, silme, kilitleme, yetki ve ileride kurallar.
// ============================================================================

// managed  : Kaydetme, okuma ve kilitleme gibi standart isleri RAP cercevesi
//            kendisi yapar. Biz yalnizca is kurallarini (dogrulama, hesaplama,
//            aksiyon) yazariz.
// implementation in class ... unique : Is kurallarinin kodu bu sinifta
//            yazilacak. "unique" = her kural tek bir yerde uygulanir.
managed implementation in class zbp_r_prm_promo_mk unique;

// strict ( 2 ) : Sozdizimi kontrolunu en siki seviyede yapar. Eski ve
//                onerilmeyen kullanimlara izin vermez. Yeni projelerde standart.
strict ( 2 );

// ----------------------------------------------------------------------------
// 1) KOK VARLIK: Kampanya basligi
//    "alias Promotion" = kodun icinde bu varliga kisa adla erisecegiz.
// ----------------------------------------------------------------------------
define behavior for ZR_PRM_PROMO_MK alias Promotion

// Veriler bu tabloya yazilir. Managed senaryoda INSERT/UPDATE/DELETE
// komutlarini RAP bizim yerimize calistirir.
persistent table zprm_promo_mk

// lock master : Kilitleme bu seviyede yapilir. Bir kullanici kampanyayi
// duzenlerken baskasi ayni kampanyayi degistiremez.
lock master

// authorization master ( global ) : Yetki kontrolu bu seviyede yapilir.
// "global" = kayda bakmadan genel yetki ("bu kullanici kampanya
// olusturabilir mi?"). Kontrol kodu davranis sinifinda olacak.
authorization master ( global )

// etag master : Iyimser kilit. Kullanici ekranda kaydi actiginda bu alanin
// degeri saklanir; kaydederken deger degismisse (biri arada degistirmis)
// islem reddedilir. Boylece kimse digerinin degisikligini ezmez.
etag master LocalLastChangedAt
{
  // Izin verilen standart islemler
  create;   // Yeni kampanya olusturma
  update;   // Kampanya degistirme
  delete;   // Kampanya silme (kalemleri de beraber silinir, composition)

  // Kampanya uzerinden yeni kalem eklenebilsin.
  // Kalemler tek basina degil, her zaman bir kampanyanin icinde olusturulur.
  association _Item { create; }

  // UUID anahtari sistem tarafindan otomatik uretilir (managed numbering),
  // kullanici bu alani goremez/degistiremez (readonly).
  field ( numbering : managed, readonly ) PromoUUID;

  // Kim, ne zaman olusturdu/degistirdi bilgileri: RAP bunlari @Semantics
  // anotasyonlarina bakarak otomatik doldurur. Kullanici degistiremez.
  field ( readonly ) LocalCreatedBy, LocalCreatedAt,
                     LocalLastChangedBy, LocalLastChangedAt, LastChangedAt;

  // CDS'teki alan adlari (CamelCase) ile tablodaki alan adlari (snake_case)
  // farkli oldugu icin hangi alanin hangisine yazilacagini soyluyoruz.
  // Solda CDS alani, sagda tablo alani.
  mapping for zprm_promo_mk
  {
    PromoUUID          = promo_uuid;
    PromoID            = promo_id;
    Description        = description;
    PromoType          = promo_type;
    ValidFrom          = valid_from;
    ValidTo            = valid_to;
    Status             = status;
    CurrencyCode       = currency_code;
    LocalCreatedBy     = local_created_by;
    LocalCreatedAt     = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}

// ----------------------------------------------------------------------------
// 2) ALT VARLIK: Kampanya kalemi
// ----------------------------------------------------------------------------
define behavior for ZR_PRM_PITEM_MK alias Item

persistent table zprm_pitem_mk

// lock dependent by _Promo : Kalemin kendi kilidi yok. Bir kalem
// degistirildiginde bagli oldugu kampanya kilitlenir. Boylece ayni
// kampanyanin farkli kalemlerini iki kisi ayni anda degistiremez.
lock dependent by _Promo

// Yetki de kampanyadan devralinir: kampanyayi degistirebilen,
// kalemlerini de degistirebilir.
authorization dependent by _Promo

// Kalemin kendi degisiklik zaman damgasi var; ayni iyimser kilit mantigi.
etag master LocalLastChangedAt
{
  // Kalem burada yalnizca degistirilip silinebilir.
  // Olusturma yukarida kampanya uzerinden (_Item { create; }) yapilir.
  update;
  delete;

  // Kalemden bagli oldugu kampanyaya gecis (okuma icin gerekli).
  association _Promo;

  // Kalem anahtari otomatik uretilir; ust kayit baglantisi (ParentUUID)
  // RAP tarafindan doldurulur, kullanici degistiremez.
  field ( numbering : managed, readonly ) ItemUUID;
  field ( readonly ) ParentUUID, LocalLastChangedAt;

  // CDS alani = tablo alani eslestirmesi
  mapping for zprm_pitem_mk
  {
    ItemUUID           = item_uuid;
    ParentUUID         = parent_uuid;
    ProductID          = product_id;
    RegularPrice       = regular_price;
    PromoPrice         = promo_price;
    DiscountPct        = discount_pct;
    CurrencyCode       = currency_code;
    LocalLastChangedAt = local_last_changed_at;
  }
}